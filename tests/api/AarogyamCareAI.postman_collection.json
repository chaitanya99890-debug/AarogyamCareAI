  "item": [
    {
      "name": "Node - Service Health",
      "item": [
        {
          "name": "GET /api/health - database ready",
          "request": { "method": "GET", "url": "{{node_base_url}}/api/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body).to.include({ status: 'ok', database: 'ready' });"] } }]
        }
      ]
    },
    {
      "name": "Node - Authentication",
      "item": [
        {
          "name": "POST /api/auth/login - valid synthetic user",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}" }, "url": "{{node_base_url}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.user.role).to.eql('user');", "pm.expect(body.token).to.be.a('string').and.not.empty;", "pm.collectionVariables.set('user_token', body.token);"] } }]
        },
        {
          "name": "POST /api/auth/login - invalid credentials",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"missing-user@example.test\",\n  \"password\": \"incorrect-password\"\n}" }, "url": "{{node_base_url}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));", "pm.expect(pm.response.json().message).to.eql('Incorrect email or password.');"] } }]
        },
        {
          "name": "POST /api/auth/admin/login - valid synthetic admin",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" }, "url": "{{node_base_url}}/api/auth/admin/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.user.role).to.eql('admin');", "pm.expect(body.token).to.be.a('string').and.not.empty;", "pm.collectionVariables.set('admin_token', body.token);"] } }]
        },
        {
          "name": "POST /api/auth/admin/login - normal user rejected",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}" }, "url": "{{node_base_url}}/api/auth/admin/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));", "pm.expect(pm.response.json().message).to.eql('Incorrect email or password.');"] } }]
        }
      ]
    },
    {
      "name": "Node - User Data and Validation",
      "item": [
        {
          "name": "GET /api/appointments - unauthorized",
          "request": { "method": "GET", "url": "{{node_base_url}}/api/appointments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "GET /api/appointments - authorized",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }], "url": "{{node_base_url}}/api/appointments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().appointments).to.be.an('array');"] } }]
        },
        {
          "name": "POST /api/appointments - missing required fields",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{node_base_url}}/api/appointments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().message).to.include('Doctor name');"] } }]
        },
        {
          "name": "POST /api/appointments - create temporary record",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"doctor\": \"API Test Doctor {{$guid}}\",\n  \"date\": \"2031-01-15\",\n  \"time\": \"10:00\",\n  \"reminder\": \"1d\",\n  \"reminderMessage\": \"Automated API test appointment\",\n  \"patientPhone\": \"\",\n  \"smsConsent\": false\n}" }, "url": "{{node_base_url}}/api/appointments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.appointment.smsStatus).to.eql('not_scheduled');", "pm.collectionVariables.set('appointment_id', body.appointment.id);"] } }]
        },
        {
          "name": "PUT /api/appointments/:id - update temporary record",
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"doctor\": \"API Test Doctor Updated\",\n  \"date\": \"2031-01-16\",\n  \"time\": \"11:00\",\n  \"reminder\": \"2d\",\n  \"reminderMessage\": \"Updated automated API test appointment\",\n  \"patientPhone\": \"\",\n  \"smsConsent\": false\n}" }, "url": "{{node_base_url}}/api/appointments/{{appointment_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().appointment.doctor).to.eql('API Test Doctor Updated');"] } }]
        },
        {
          "name": "DELETE /api/appointments/:id - clean up temporary record",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }], "url": "{{node_base_url}}/api/appointments/{{appointment_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().success).to.eql(true);"] } }]
        },
        {
          "name": "GET /api/health-profile - authorized",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }], "url": "{{node_base_url}}/api/health-profile" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "GET /api/disease-predictions - authorized history",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }], "url": "{{node_base_url}}/api/disease-predictions" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().predictions).to.be.an('array');"] } }]
        },
        {
          "name": "GET /api/risk-assessments - authorized history",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }], "url": "{{node_base_url}}/api/risk-assessments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().assessments).to.be.an('array');"] } }]
        }
      ]
    },
    {
      "name": "Node - Chat and Report Analysis (dev:test only)",
      "item": [
        {
          "name": "POST /api/chat - missing message",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"message\": \"   \" }" }, "url": "{{node_base_url}}/api/chat" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().message).to.eql('A message is required.');"] } }]
        },
        {
          "name": "POST /api/chat - mocked valid exchange",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"message\": \"API automation health-information test\",\n  \"chatId\": \"postman-api-test-{{$guid}}\"\n}" }, "url": "{{node_base_url}}/api/chat" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.reply).to.be.a('string').and.not.empty;", "pm.collectionVariables.set('chat_id', body.chatId);"] } }]
        },
        {
          "name": "DELETE /api/chat/conversations/:id - clean up test conversation",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }], "url": "{{node_base_url}}/api/chat/conversations/{{chat_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().success).to.eql(true);"] } }]
        },
        {
          "name": "POST /api/reports/analyze - unsupported file type",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fileName\": \"not-a-report.txt\",\n  \"mimeType\": \"text/plain\",\n  \"data\": \"dGVzdA==\"\n}" }, "url": "{{node_base_url}}/api/reports/analyze" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().message).to.include('PDF, PNG, or JPG');"] } }]
        },
        {
          "name": "POST /api/reports/analyze - synthetic PNG with mock analysis",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fileName\": \"synthetic-api-test.png\",\n  \"mimeType\": \"image/png\",\n  \"data\": \"{{sample_png_base64}}\"\n}" }, "url": "{{node_base_url}}/api/reports/analyze" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.summary).to.eql('Mock report summary for automated testing only.');", "pm.expect(body.keyFindings).to.be.an('array');"] } }]
        }
      ]
    },
