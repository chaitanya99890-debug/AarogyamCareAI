          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().detail).to.include('Systolic blood pressure');"] } }]
        },
        {
          "name": "POST /predict-risk - incorrect data type",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"age\": \"not-a-number\", \"gender\": \"female\", \"height\": 165, \"weight\": 62,\n  \"systolic_bp\": 120, \"diastolic_bp\": 80, \"cholesterol\": 1, \"glucose\": 1,\n  \"smoking\": false, \"alcohol\": false, \"physical_activity\": true\n}" }, "url": "{{ml_base_url}}/predict-risk" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 422', () => pm.response.to.have.status(422));"] } }]
