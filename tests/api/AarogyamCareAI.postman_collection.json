    {
      "name": "Python ML - Disease Prediction",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{ml_base_url}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('ok');"] } }]
        },
        {
          "name": "GET /symptoms - capture a model-supported symptom",
          "request": { "method": "GET", "url": "{{ml_base_url}}/symptoms" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.symptoms).to.be.an('array').and.not.empty;", "pm.collectionVariables.set('first_symptom', body.symptoms[0]);"] } }]
        },
        {
          "name": "POST /predict-disease - valid model-supported symptom",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"symptoms\": [\"{{first_symptom}}\"] }" }, "url": "{{ml_base_url}}/predict-disease" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.prediction).to.be.a('string').and.not.empty;", "pm.expect(body.confidence).to.be.a('number');"] } }]
        },
        {
          "name": "POST /predict-disease - missing symptoms",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{ml_base_url}}/predict-disease" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 422', () => pm.response.to.have.status(422));"] } }]
        },
        {
          "name": "POST /predict-disease - unknown symptom",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"symptoms\": [\"not-a-model-symptom\"] }" }, "url": "{{ml_base_url}}/predict-disease" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().detail).to.include('Unknown symptom');"] } }]
        }
      ]
    },
    {
      "name": "Python ML - Health Risk Prediction",
      "item": [
        {
          "name": "POST /predict-risk - valid request",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"age\": 35,\n  \"gender\": \"female\",\n  \"height\": 165,\n  \"weight\": 62,\n  \"systolic_bp\": 120,\n  \"diastolic_bp\": 80,\n  \"cholesterol\": 1,\n  \"glucose\": 1,\n  \"smoking\": false,\n  \"alcohol\": false,\n  \"physical_activity\": true\n}" }, "url": "{{ml_base_url}}/predict-risk" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.risk_level).to.be.oneOf(['Lower Risk', 'Higher Risk']);", "pm.expect(body.prediction).to.be.oneOf([0, 1]);", "pm.expect(body.probability).to.be.a('number');"] } }]
        },
        {
          "name": "POST /predict-risk - missing required fields",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{ml_base_url}}/predict-risk" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 422', () => pm.response.to.have.status(422));", "pm.expect(pm.response.json().detail).to.include('Invalid request');"] } }]
        },
