    { "key": "user_email", "value": "" },
    { "key": "user_password", "value": "", "type": "secret" },
    { "key": "admin_email", "value": "" },
    { "key": "admin_password", "value": "", "type": "secret" },
    { "key": "user_token", "value": "", "type": "secret" },
    { "key": "admin_token", "value": "", "type": "secret" },
    { "key": "appointment_id", "value": "" },
    { "key": "chat_id", "value": "" },
